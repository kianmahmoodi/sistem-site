# Copy this file to deploy/.env and change every value before going live.

# Port the site answers on (80 = plain http, put HTTPS in front of it).
WEB_PORT=80

# Database (use letters and digits only — the password is embedded in the API URL).
POSTGRES_USER=burger
POSTGRES_PASSWORD=change-me-alphanumeric
POSTGRES_DB=burger

# Signs the session cookies. Use a long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me-long-random-string

# Created once on the first boot of an empty database. Change it right after the first login.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-me-strong-password
